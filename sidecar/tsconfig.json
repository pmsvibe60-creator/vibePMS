{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "pdfmake/interfaces": [
        "./node_modules/@types/pdfmake/interfaces.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}