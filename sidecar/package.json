{
  "name": "vibepms-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "setup": "tsx src/cli.ts setup",
    "job": "tsx src/cli.ts job",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "handlebars": "4.7.9",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.12",
    "pdfmake": "0.2.23",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0"
}
