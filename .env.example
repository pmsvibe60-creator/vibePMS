# ---- Twenty ----
TWENTY_TAG=v2.45.8
TWENTY_HOST_PORT=3020
SERVER_URL=http://localhost:3020
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=            # openssl rand -hex 32
ENCRYPTION_KEY=                  # openssl rand -base64 32
APP_SECRET=                      # openssl rand -base64 32
TWENTY_EMAIL_DRIVER=logger       # smtp once SMTP_* is set

# ---- Tunnel ----
CLOUDFLARED_CREDENTIALS=./cloudflared/credentials.json

# ---- Sidecar ----
SIDECAR_HOST_PORT=4000
PUBLIC_URL=http://localhost:4000
TWENTY_API_KEY=                  # Twenty → Settings → APIs & Webhooks → API key
TWENTY_WEBHOOK_SECRET=           # secret of the Twenty webhook pointing at $PUBLIC_URL/webhooks/twenty
AUTO_SETUP=false                 # true: provision Twenty fields on startup once TWENTY_API_KEY is set
ADMIN_TOKEN=                     # openssl rand -hex 24 — protects /admin/* endpoints
TZ=Europe/Tallinn

# ---- CasaPay ----
CASAPAY_API_BASE_URL=https://manage.test.casapay.com/api/v1/gateway
CASAPAY_API_KEY=                 # sk_test_...
CASAPAY_WEBHOOK_SECRET=
CASAPAY_AGREEMENT_TYPE=ontime    # payment_link | ontime | cover
CASAPAY_DEPOSIT_MODE=choice      # deposit_upfront | deposit_guaranteed | choice

# ---- Owner entity (appears on contracts + invoices) ----
OWNER_NAME=
OWNER_REG_CODE=
OWNER_VAT_NO=
OWNER_ADDRESS=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_REPRESENTATIVE=            # board member signing contracts
INVOICE_PREFIX=RENT
RENT_DUE_DAY_DEFAULT=5
RENT_INVOICE_DAY=1               # cron day of month to issue invoices

# ---- Outgoing mail (signing links, checkout links) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
