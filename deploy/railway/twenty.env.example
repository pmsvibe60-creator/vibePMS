NODE_PORT=3000
PORT=3000
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
SERVER_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
STORAGE_TYPE=s3
STORAGE_S3_NAME=REPLACE_WITH_BUCKET_NAME
STORAGE_S3_REGION=REPLACE_WITH_BUCKET_REGION
STORAGE_S3_ENDPOINT=REPLACE_WITH_BUCKET_ENDPOINT
STORAGE_S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_ACCESS_KEY
STORAGE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SECRET
APP_SECRET=REPLACE_WITH_GENERATED_SECRET
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET
EMAIL_DRIVER=logger
